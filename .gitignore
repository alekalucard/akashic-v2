# akashic-v2 -- defensive denylist. sync_code.py is the real filter (allowlist + denylist); this file
# exists so that a hand copy or a future rule slip cannot land data, models, build output or a secret.
# Her own nested .gitignore files under code/ are mirrored verbatim and stay active too (her root one
# ignores Cargo.lock; the lock files are force-added on purpose -- see README).

# ---- secrets: never, anywhere -------------------------------------------------------------------
personal_ai_secrets.json
*secret*.json
*_secrets.*
secrets.json
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.ppk
*.p8
*.kdbx
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.netrc
_netrc
.npmrc
.pypirc
.git-credentials
credentials*.json
token*.json
client_secret*.json
service_account*.json
gcp-oauth*.json
*.token
*access_token*
*refresh_token*
known_hosts
authorized_keys

# ---- machine-local config (permission allowlists, hooks pointing at this machine) --------------------
*.local.json
*.local.toml
*.local.yaml
*.local.yml
*.local.ini
*.local.cfg

# ---- generated runtime snapshots that sit next to code -------------------------------------------
code/dashboard/ui/behavior_tree.json
code/dashboard/ui/behavior_tree.mermaid

