# ═══════════════════════════════════════════════════════════════════════════════
# AKASHIC SYSTEM - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# CORE PATHS
# ═══════════════════════════════════════════════════════════════════════════════

# Base directory for Akashic system
AKASHIC_ROOT=F:/Sandbox/failure_factory/akashic_v2

# State directory for persistent data
AKASHIC_STATE_DIR=F:/Sandbox/failure_factory/akashic_v2/state

# ═══════════════════════════════════════════════════════════════════════════════
# API KEYS - NEVER COMMIT THESE!
# ═══════════════════════════════════════════════════════════════════════════════

# Anthropic API (for Claude integration)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs (for voice synthesis, optional)
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# OpenAI (for embeddings only if not using native, optional)
OPENAI_API_KEY=your_openai_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# THREAD POOL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# MCP worker threads (default: CPU_count + 4, max 32)
# AKASHIC_MCP_WORKERS=16

# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK PORTS
# ═══════════════════════════════════════════════════════════════════════════════

# PostalCore AKP server port
POSTAL_CORE_PORT=8766

# MCP server port
MCP_SERVER_PORT=8767

# Tauri GUI API port
TAURI_API_PORT=8765

# ═══════════════════════════════════════════════════════════════════════════════
# INFERENCE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Path to GGUF model file for AkashicInferenceFairy
# RWKV_MODEL_PATH=F:/Models/rwkv-7-world-0.1b-q8_0.gguf

# Device for inference (cuda, cpu)
INFERENCE_DEVICE=cuda

# Maximum GPU memory to use (GB)
INFERENCE_MAX_MEMORY_GB=12.0

# ═══════════════════════════════════════════════════════════════════════════════
# VECTOR DATABASE (optional - Qdrant)
# ═══════════════════════════════════════════════════════════════════════════════

# Qdrant connection URL
# QDRANT_URL=http://localhost:6333

# Qdrant API key (if using Qdrant Cloud)
# QDRANT_API_KEY=your_qdrant_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# DEBUG/DEVELOPMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable detailed tracing
# AKASHIC_TRACE=1

# ═══════════════════════════════════════════════════════════════════════════════
