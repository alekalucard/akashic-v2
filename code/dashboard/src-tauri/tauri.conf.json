{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akashic Dashboard",
  "version": "0.1.0",
  "identifier": "com.akashic.dashboard",
  "build": {
    "frontendDist": "http://127.0.0.1:5757",
    "devUrl": "http://127.0.0.1:5757"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Akashic Dashboard",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
